{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@shuvcode/goal-plugin",
  "version": "2.0.0-alpha-20",
  "type": "module",
  "license": "MIT",
  "description": "Session goal plugin for OpenCode V2: one explicit objective per Session with bounded continuation, structured completion evidence, and durable lifecycle state.",
  "scripts": {
    "test": "bun test --timeout 5000",
    "typecheck": "tsgo --noEmit",
    "pack:check": "bun pm pack --dry-run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
