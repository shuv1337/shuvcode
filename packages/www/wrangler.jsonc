{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuvcode-www",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "dev": {
      "name": "shuvcode-www-dev",
      "routes": [
        {
          "pattern": "dev.shuv.ai/v2*",
          "zone_name": "shuv.ai"
        }
      ]
    },
    "production": {
      "name": "shuvcode-www-production",
      "routes": [
        {
          "pattern": "shuv.ai/v2*",
          "zone_name": "shuv.ai"
        }
      ]
    }
  }
}
